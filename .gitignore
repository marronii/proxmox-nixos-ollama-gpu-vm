# Ignore NixOS interactive test driver history
**/.nixos-test-history

# Nix build outputs
result
result-*
*.drv

# Nix flakes
flake.lock

# Local secrets and environment files
.env
.env.*
*.env
*.secret
*.secrets
secrets/
secret/
private/
credentials/
tokens/
keys/

